{
  "name": "orientsol",
  "version": "3.0.0",
  "description": "Estudio y planificación energética fotovoltaica",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --windows"
  },
  "author": "Universidad de Jaén",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "es.ujaen.orientsol",
    "productName": "OrientSol 3.0",
    "extraResources": [
      {
        "from": "input_data/",
        "to": "input_data/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/img/logo_uja.ico"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
